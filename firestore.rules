rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "student";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function activeApprovedStudent() {
      return isStudent()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.paymentStatus == "Approved"
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.accountStatus == "Active";
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.role == "student";
      allow update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow create: if isOwner(studentId);
      allow update, delete: if isAdmin();
    }

    match /paymentRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if isAdmin()
        || (activeApprovedStudent()
          && (resource.data.batchId == get(/databases/$(database)/documents/students/$(request.auth.uid)).data.batchId
            || resource.data.studentId == request.auth.uid));
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && request.resource.data.type == "payment";
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
